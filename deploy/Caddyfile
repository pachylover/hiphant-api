# HiPhant API 리버스 프록시.
# 도메인은 .env 의 API_DOMAIN 에서 온다. TLS 인증서는 Caddy 가 Let's Encrypt 로 자동 발급/갱신한다.

{$API_DOMAIN} {
	tls /etc/caddy/ssl/domain.cert.pem /etc/caddy/ssl/private.key.pem

	encode gzip

	reverse_proxy api:8080 {
		# 하이라이트 생성 진행률(SSE, /api/v1/highlights/{id}/stream)이 버퍼링되지 않도록 필수.
		# 이걸 빼면 진행률이 끊겨 보이거나 완료된 뒤에 한꺼번에 도착한다.
		flush_interval -1

		# 채팅 수집이 오래 걸리는 요청은 없지만, SSE 연결이 끊기지 않도록 넉넉히 둔다
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 3
			# Caddy 는 컨테이너 안에서 root 로 돌아 기본이 0600 이다.
			# 호스트의 ubuntu 계정이 sudo 없이 tail 할 수 있도록 644 로 만든다.
			mode 644
		}
	}
}
